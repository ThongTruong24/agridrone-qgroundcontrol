        <file alias="QGroundControl/FlyView/OnScreenGimbalController.qml">src/FlyView/OnScreenGimbalController.qml</file>
        <file alias="QGroundControl/FlyView/FlyViewToolStripActionList.qml">src/FlyViewToolStripActionList.qml</file>
        <file alias="QGroundControl/Toolbar/FlyViewToolBar.qml">src/FlyViewToolBar.qml</file>
    </qresource>
</RCC>

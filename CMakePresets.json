{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Debug (Ninja)",
      "description": "Cấu hình build Debug tương đối không phụ thuộc đường dẫn tuyệt đối",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{HOME}/Qt/6.11.1/gcc_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
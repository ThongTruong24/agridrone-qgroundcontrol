cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/../platform/Android.cmake")
set(_sandbox "${CMAKE_CURRENT_BINARY_DIR}/qgc_android_pkgconfig_alias_fixture")
file(REMOVE_RECURSE "${_sandbox}")
set(GStreamer_ROOT_DIR "${_sandbox}")
set(CMAKE_HOST_WIN32 TRUE)

# Only SDK alias restoration is under test, before layout and pkg-config setup.
function(gstreamer_create_layout_target)
endfunction()
function(gstreamer_apply_pkgconfig_env)
endfunction()

set(_pc_dir "${_sandbox}/lib/pkgconfig")
file(MAKE_DIRECTORY "${_pc_dir}")
set(_png_pc "Name: libpng\nVersion: 1.6.56\nLibs: -lpng16\n")
file(WRITE "${_pc_dir}/libpng16.pc" "${_png_pc}")
_qgc_discover_android_sdk()
if(NOT EXISTS "${_pc_dir}/libpng.pc")
    message(FATAL_ERROR "Windows Android SDK extraction must restore the libpng pkg-config alias")
endif()
file(READ "${_pc_dir}/libpng.pc" _alias)
if(NOT _alias STREQUAL _png_pc)
    message(FATAL_ERROR "The libpng alias must retain libpng16 metadata")
endif()

file(WRITE "${_pc_dir}/libpng.pc" "Existing alias\n")
_qgc_discover_android_sdk()
file(READ "${_pc_dir}/libpng.pc" _alias)
if(NOT _alias STREQUAL "Existing alias\n")
    message(FATAL_ERROR "An existing libpng alias must be preserved")
endif()
file(REMOVE "${_pc_dir}/libpng.pc" "${_pc_dir}/libpng16.pc")
_qgc_discover_android_sdk()
if(EXISTS "${_pc_dir}/libpng.pc")
    message(FATAL_ERROR "Do not fabricate libpng metadata when the SDK lacks libpng16")
endif()
file(REMOVE_RECURSE "${_sandbox}")
message(STATUS "Android SDK restores missing PNG metadata aliases and preserves existing files")
